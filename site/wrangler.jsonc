{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aisafetyrisks-org",
  "compatibility_date": "2026-09-25",
  // Assets-only Worker: the whole site is static HTML built by `aisr-site build`.
  "build": {
    "command": "uv run --frozen aisr-site build",
    "watch_dir": ["content", "static", "src"]
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "aisafetyrisks.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
