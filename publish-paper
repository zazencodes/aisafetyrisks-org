#!/bin/sh
# Turn a paper into a draft explainer on aisafetyrisks.org: video, captions, thumbnail,
# website page and YouTube package. Accepts a PDF path, an arXiv id or a URL.
# After human review: uv run paper-video approve <slug> --reviewer "Name", then deploy.
set -eu
cd "$(dirname "$0")"
exec uv run --frozen paper-video "$@"
